NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dlander?schema=public
JWT_ACCESS_SECRET=test-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
AUTH_REFRESH_TOKEN_TRANSPORT=body
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Dlander Test <no-reply@dlander.test>
API_REQUEST_STORAGE_ENABLED=true
API_REQUEST_BODY_CAPTURE_ENABLED=false
API_REQUEST_PERSISTENCE_MODE=sync
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=test-payment-webhook-secret-32-characters
PAYMENT_RETURN_URL=http://localhost:5173/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/payment/cancel
MOCK_PAYMENT_ENABLED=true
AI_CREDIT_CHARGING_ENABLED=false
