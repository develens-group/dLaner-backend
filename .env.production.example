NODE_ENV=production
PORT=3000

# Use Neon's pooled connection string at runtime on Vercel.
# Keep sslmode=require. Use Neon's direct URL only while running migrations locally.
DATABASE_URL=postgresql://neondb_owner:npg_Z7nCh3aLStvP@ep-wild-night-asuufih2-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate three different random values with at least 32 characters.
JWT_ACCESS_SECRET=35bb917e5e6d50f55c0f2c2d8d43d12f6f4fc77071cb9d9134a921797cdec79940b7e12741dcd1a36c89c205fa8cbba5
JWT_REFRESH_SECRET=bfc6a2e40f8f6d6fb72bd2744cd88e11c2d8d204a7b6b77aede4fcd7ec6c7603fe739754626efdefe70ee64f7d08665d
PAYMENT_WEBHOOK_SECRET=ec204b65b91d0675a949fb3725d6264c3b44b78c039dbf383e88cd1f3678d8434dbeb403dcc867714e9303a632345d80
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_EXPIRES_IN=24h
PASSWORD_RESET_EXPIRES_IN=1h

# Replace these after deploying the frontend.
FRONTEND_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example
AUTH_REFRESH_TOKEN_TRANSPORT=body
AUTH_REFRESH_COOKIE_NAME=refresh_token

# Resend's HTTPS API is suitable for Vercel Functions (no persistent SMTP socket).
MAIL_TRANSPORT=resend
RESEND_API_KEY=re_replace_me
# For initial testing, Resend permits onboarding@resend.dev only for your account email.
# Replace it with no-reply@your-domain after verifying a domain in Resend.
MAIL_FROM=Dlander <onboarding@resend.dev>

LOG_LEVELS=log,error,warn
TRUST_PROXY=1

# Keep the Neon Free database small.
API_REQUEST_STORAGE_ENABLED=true
API_REQUEST_BODY_CAPTURE_ENABLED=false
API_REQUEST_RETENTION_DAYS=7
API_REQUEST_MAX_BODY_BYTES=8192
API_REQUEST_MAX_QUERY_BYTES=4096
# A function may stop immediately after sending its response, so persist synchronously.
API_REQUEST_PERSISTENCE_MODE=sync
API_REQUEST_QUEUE_MAX_SIZE=1000
API_REQUEST_CAPTURE_IP=false

AI_HISTORY_STORE_INPUT=true
AI_HISTORY_STORE_OUTPUT=true
AI_HISTORY_MAX_INPUT_BYTES=8192
AI_HISTORY_MAX_OUTPUT_BYTES=8192
AI_HISTORY_RETENTION_DAYS=14
AI_PROVIDER_TIMEOUT_MS=30000

DEFAULT_CURRENCY=USD
CREDIT_MAX_TRANSACTION_AMOUNT=1000000000
CREDIT_RESERVATION_TTL_SECONDS=900

# No real payment provider is installed yet. Never enable mock payments online.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_ENABLED=false
PAYMENT_RETURN_URL=https://your-frontend.example/credits/payment/success
PAYMENT_CANCEL_URL=https://your-frontend.example/credits/payment/cancel

AI_CREDIT_CHARGING_ENABLED=true
AI_CREDIT_FIXED_COST=1
AI_CREDIT_INPUT_UNIT_BYTES=4096
AI_CREDIT_INPUT_UNIT_COST=1
AI_CREDIT_OUTPUT_UNIT_BYTES=4096
AI_CREDIT_OUTPUT_UNIT_COST=0
