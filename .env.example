NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dlander?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_EXPIRES_IN=24h
EMAIL_VERIFICATION_REQUIRED=false
PASSWORD_RESET_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
AUTH_REFRESH_TOKEN_TRANSPORT=body
AUTH_REFRESH_COOKIE_NAME=refresh_token
CAPTCHA_FAILURE_THRESHOLD=2
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CORS_ORIGINS=http://localhost:5173
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dlander <no-reply@dlander.local>
# Production with Resend:
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=re_replace_me
# MAIL_FROM=Dlander <onboarding@resend.dev>
LOG_LEVELS=log,error,warn
TRUST_PROXY=1
API_REQUEST_STORAGE_ENABLED=true
API_REQUEST_BODY_CAPTURE_ENABLED=false
API_REQUEST_RETENTION_DAYS=30
API_REQUEST_MAX_BODY_BYTES=8192
API_REQUEST_MAX_QUERY_BYTES=4096
API_REQUEST_PERSISTENCE_MODE=buffered
API_REQUEST_QUEUE_MAX_SIZE=1000
API_REQUEST_CAPTURE_IP=true
AI_HISTORY_STORE_INPUT=true
AI_HISTORY_STORE_OUTPUT=true
AI_HISTORY_MAX_INPUT_BYTES=32768
AI_HISTORY_MAX_OUTPUT_BYTES=32768
AI_HISTORY_RETENTION_DAYS=90
AI_HISTORY_STORAGE_DRIVER=postgres
AI_HISTORY_D1_ACCOUNT_ID=
AI_HISTORY_D1_DATABASE_ID=
AI_HISTORY_D1_API_TOKEN=
AI_PROVIDER_TIMEOUT_MS=30000
DEFAULT_CURRENCY=USD
CREDIT_MAX_TRANSACTION_AMOUNT=1000000000
CREDIT_RESERVATION_TTL_SECONDS=900
PAYMENT_PROVIDER=mock
CREDIT_PURCHASE_ENABLED=false
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
PAYMENT_RETURN_URL=http://localhost:5173/credits/payment/success
PAYMENT_CANCEL_URL=http://localhost:5173/credits/payment/cancel
MOCK_PAYMENT_ENABLED=true
AI_CREDIT_CHARGING_ENABLED=true
AI_CREDIT_FIXED_COST=1
AI_CREDIT_INPUT_UNIT_BYTES=4096
AI_CREDIT_INPUT_UNIT_COST=1
AI_CREDIT_OUTPUT_UNIT_BYTES=4096
AI_CREDIT_OUTPUT_UNIT_COST=0
TEMPLATE_STORAGE_DRIVER=local
TEMPLATE_STORAGE_LOCAL_PATH=.data/templates
TEMPLATE_STORAGE_BUCKET=
TEMPLATE_STORAGE_REGION=auto
TEMPLATE_STORAGE_ENDPOINT=
TEMPLATE_STORAGE_ACCESS_KEY=
TEMPLATE_STORAGE_SECRET_KEY=
TEMPLATE_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/template-objects
TEMPLATE_LIBRARY_TYPE=dlanderlib
TEMPLATE_MAX_BUNDLE_BYTES=5000000
TEMPLATE_MAX_ITEMS=100
TEMPLATE_MAX_ELEMENTS_PER_ITEM=2000
TEMPLATE_SHARE_BASE_URL=http://localhost:3000
LAND_REVISION_RETENTION=3
LAND_MAX_JSON_BYTES=10000000
