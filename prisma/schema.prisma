generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
  DELETED
}

enum ApiRequestSource {
  WEB
  MOBILE
  ADMIN
  INTERNAL
  WEBHOOK
  UNKNOWN
}

enum AiRequestStatus {
  CREATED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiOperation {
  CHAT
  TEXT_GENERATION
  IMAGE_GENERATION
  EMBEDDING
  TRANSCRIPTION
  CUSTOM
}

enum CreditLedgerType {
  PURCHASE
  ADMIN_GRANT
  ADMIN_DEDUCTION
  RESERVATION
  RESERVATION_CAPTURE
  RESERVATION_RELEASE
  CONSUMPTION
  REFUND
  EXPIRATION
  REVERSAL
  PROMOTION
}

enum CreditReservationStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum CreditOrderStatus {
  CREATED
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  email             String                   @unique @db.VarChar(320)
  passwordHash      String
  displayName       String?                  @db.VarChar(100)
  role              UserRole                 @default(USER)
  status            UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  sessions          Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  apiRequests       ApiRequestRecord[]
  aiRequests        AiRequest[]
  auditLogs         AuditLog[]                @relation("AuditActor")
  creditAccount     CreditAccount?
  creditLedger      CreditLedgerEntry[]       @relation("LedgerOwner")
  createdCreditLedger CreditLedgerEntry[]     @relation("LedgerCreator")
  creditReservations CreditReservation[]
  creditOrders      CreditPurchaseOrder[]

  @@index([status])
  @@index([createdAt])
}

model ApiRequestRecord {
  id                  String           @id @default(uuid()) @db.Uuid
  requestId           String           @unique @db.VarChar(128)
  userId              String?          @db.Uuid
  sessionId           String?          @db.Uuid
  method              String           @db.VarChar(16)
  route               String           @db.VarChar(512)
  path                String           @db.VarChar(2048)
  queryJson           Json?
  requestBodyJson     Json?
  responseSummaryJson Json?
  bodyCaptured        Boolean          @default(false)
  bodyTruncated       Boolean          @default(false)
  bodyRedacted        Boolean          @default(false)
  statusCode          Int
  durationMs          Int
  ipAddress           String?          @db.VarChar(64)
  userAgent           String?          @db.VarChar(512)
  contentLength       Int?
  responseLength      Int?
  errorCode           String?          @db.VarChar(100)
  errorMessage        String?          @db.VarChar(500)
  source              ApiRequestSource @default(UNKNOWN)
  createdAt           DateTime         @default(now())
  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([route, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
  @@index([errorCode, createdAt])
}

model AiRequest {
  id                    String          @id @default(uuid()) @db.Uuid
  requestId             String?         @db.VarChar(128)
  userId                String          @db.Uuid
  idempotencyKey        String?         @db.VarChar(128)
  provider              String          @db.VarChar(100)
  model                 String          @db.VarChar(100)
  operation             AiOperation
  status                AiRequestStatus @default(CREATED)
  inputJson              Json?
  inputHash              String          @db.VarChar(64)
  inputOmitted           Boolean         @default(false)
  inputTruncated         Boolean         @default(false)
  inputRedacted          Boolean         @default(false)
  outputJson             Json?
  outputOmitted          Boolean         @default(false)
  outputTruncated        Boolean         @default(false)
  outputRedacted         Boolean         @default(false)
  providerRequestId      String?         @db.VarChar(255)
  promptTokens           Int?
  completionTokens       Int?
  totalTokens            Int?
  estimatedCreditCost    Int?
  chargedCreditAmount    Int?
  creditReservationId   String?         @db.Uuid
  actualCreditCost      Int?
  creditChargedAt       DateTime?
  latencyMs              Int?
  errorCode              String?         @db.VarChar(100)
  errorMessage           String?         @db.VarChar(500)
  startedAt              DateTime
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  user                   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditReservation      CreditReservation? @relation(fields: [creditReservationId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, model, createdAt])
  @@index([requestId])
  @@index([creditReservationId])
}

model CreditAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  availableBalance  Int      @default(0)
  reservedBalance   Int      @default(0)
  lifetimePurchased Int      @default(0)
  lifetimeConsumed  Int      @default(0)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries     CreditLedgerEntry[]
  reservations      CreditReservation[]

  @@index([createdAt])
}

model CreditLedgerEntry {
  id                     String           @id @default(uuid()) @db.Uuid
  accountId              String           @db.Uuid
  userId                 String           @db.Uuid
  type                   CreditLedgerType
  amount                 Int
  availableDelta         Int
  reservedDelta          Int
  availableBalanceAfter  Int
  reservedBalanceAfter   Int
  referenceType          String           @db.VarChar(100)
  referenceId            String?          @db.VarChar(255)
  idempotencyKey         String?          @db.VarChar(128)
  requestHash            String?          @db.VarChar(64)
  description            String?          @db.VarChar(500)
  metadataJson           Json?
  createdByUserId        String?          @db.Uuid
  createdAt              DateTime         @default(now())
  account                CreditAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user                   User             @relation("LedgerOwner", fields: [userId], references: [id], onDelete: Restrict)
  createdBy              User?            @relation("LedgerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, type, idempotencyKey])
  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model CreditReservation {
  id             String                  @id @default(uuid()) @db.Uuid
  accountId      String                  @db.Uuid
  userId         String                  @db.Uuid
  amount         Int
  capturedAmount Int                     @default(0)
  status         CreditReservationStatus @default(ACTIVE)
  referenceType  String                  @db.VarChar(100)
  referenceId    String                  @db.VarChar(255)
  idempotencyKey String                  @db.VarChar(128)
  requestHash    String                  @db.VarChar(64)
  expiresAt      DateTime?
  capturedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  account        CreditAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  aiRequests     AiRequest[]

  @@unique([userId, idempotencyKey])
  @@index([accountId, status])
  @@index([userId, createdAt])
  @@index([expiresAt, status])
  @@index([referenceType, referenceId])
}

model CreditPackage {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(150)
  description          String?               @db.VarChar(1000)
  creditAmount         Int
  bonusCreditAmount    Int                   @default(0)
  priceMinor           Int
  currency             String                @db.VarChar(3)
  isActive             Boolean               @default(true)
  sortOrder            Int                   @default(0)
  purchaseLimitPerUser Int?
  startsAt             DateTime?
  endsAt               DateTime?
  metadataJson         Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  orders               CreditPurchaseOrder[]

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
}

model CreditPurchaseOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  userId             String            @db.Uuid
  packageId          String            @db.Uuid
  status             CreditOrderStatus @default(CREATED)
  creditAmount       Int
  bonusCreditAmount  Int
  totalCreditAmount  Int
  priceMinor         Int
  currency           String            @db.VarChar(3)
  paymentProvider    String            @db.VarChar(100)
  providerPaymentId  String?           @db.VarChar(255)
  idempotencyKey     String            @db.VarChar(128)
  requestHash        String            @db.VarChar(64)
  paidAt             DateTime?
  failedAt           DateTime?
  cancelledAt        DateTime?
  expiresAt          DateTime?
  metadataJson       Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  package            CreditPackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentAttempts    PaymentAttempt[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerPaymentId])
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  provider          String               @db.VarChar(100)
  providerPaymentId String?              @db.VarChar(255)
  status            PaymentAttemptStatus @default(CREATED)
  amountMinor       Int
  currency          String               @db.VarChar(3)
  requestJson       Json?
  responseJson      Json?
  failureCode       String?              @db.VarChar(100)
  failureMessage    String?              @db.VarChar(500)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  order             CreditPurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([provider, providerPaymentId])
}

model PaymentWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String   @db.VarChar(100)
  providerEventId String   @db.VarChar(255)
  eventType       String   @db.VarChar(100)
  signatureValid  Boolean
  payloadHash     String   @db.VarChar(64)
  payloadJson     Json?
  processedAt     DateTime?
  processingError String?  @db.VarChar(500)
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([createdAt])
  @@index([processedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(150)
  actorId    String?  @db.Uuid
  targetType String   @db.VarChar(100)
  targetId   String?  @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)
  deviceName       String?   @db.VarChar(100)
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}
